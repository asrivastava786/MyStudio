generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  emailVerified       DateTime?
  image               String?
  role                Role                 @default(DESIGNER)
  handle              String?              @unique
  country             String?
  instagram           String?
  behance             String?
  dribbble            String?
  website             String?
  passwordHash        String?
  accounts            Account[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]

  @@index([email])
  @@index([handle])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model PasswordResetToken {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String?
  email String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())


  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@index([email])
}

/// ---------- Core Product ----------
model Product {
  /// External Printify product id, used as PK
  id                        String          @id @db.VarChar(40)
  title                     String
  description               String
  visible                   Boolean         @default(true)
  isLocked                  Boolean         @default(false)
  blueprintId               Int
  printProviderId           Int
  printifyUserId            Int
  printifyShopId            Int
  createdAt                 DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime        @updatedAt @db.Timestamptz(6)
  isDeleted                 Boolean         @default(false)
  originalProductId         String?         @db.VarChar(64)
  isPrintifyExpressEligible Boolean         @default(false)
  isPrintifyExpressEnabled  Boolean         @default(false)
  isEconomyShippingEligible Boolean         @default(false)
  isEconomyShippingEnabled  Boolean         @default(false)
  creatorName               String?         @db.VarChar(120)
  creatorEmail              String?         @db.VarChar(256)
  printDetails              Json?           @db.JsonB
  salesChannelProperties    Json?           @db.JsonB
  images                    Image[]
  printAreas                PrintArea[]
  options                   ProductOption[]
  tags                      ProductTag[]
  variants                  Variant[]
  views                     View[]

  @@index([creatorEmail])
  @@index([visible, isDeleted])
  @@map("products")
}

/// ---------- Tags (global) ----------
model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique @db.VarChar(64)
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String
  tagId     Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

/// ---------- Options & Values ----------
model ProductOption {
  id               Int           @id @default(autoincrement())
  productId        String
  name             String        @db.VarChar(64)
  type             OptionType
  displayInPreview Boolean       @default(false)
  values           OptionValue[]
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId, type])
  @@map("product_options")
}

model OptionValue {
  id        Int                  @id @default(autoincrement())
  optionId  Int
  value     String               @db.VarChar(64)
  sortOrder Int?
  option    ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants  VariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId])
  @@map("option_values")
}

/// ---------- Variants ----------
model Variant {
  id                        Int                  @id @default(autoincrement())
  productId                 String
  externalId                Int // Printify variant id
  sku                       String
  costCents                 Int
  priceCents                Int
  title                     String
  grams                     Int
  isEnabled                 Boolean              @default(true)
  isDefault                 Boolean              @default(false)
  isAvailable               Boolean              @default(true)
  isPrintifyExpressEligible Boolean              @default(false)
  quantity                  Int                  @default(0)
  images                    ImageVariant[]
  printAreas                PrintAreaVariant[]
  optionValues              VariantOptionValue[]
  product                   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, externalId]) // Printify id unique within a product
  @@unique([productId, sku]) // sku unique within a product (change if you want global)
  @@index([productId, isDefault])
  @@index([productId, isAvailable])
  @@map("variants")
}

model VariantOptionValue {
  variantId     Int
  optionValueId Int

  variant     Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue OptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

/// ---------- Images (+ m2m to variants) ----------
model Image {
  id                      BigInt         @id @default(autoincrement()) @db.BigInt
  productId               String
  src                     String
  position                Position?
  isDefault               Boolean        @default(false)
  isSelectedForPublishing Boolean        @default(false)
  order                   Int?
  variants                ImageVariant[]
  product                 Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isDefault])
  @@index([productId, position])
  @@map("images")
}

model ImageVariant {
  imageId   BigInt
  variantId Int

  image   Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([imageId, variantId])
  @@map("image_variants")
}

/// ---------- Print Areas ----------
model PrintArea {
  id           Int                @id @default(autoincrement())
  productId    String
  background   String?            @db.VarChar(16)
  placeholders Json?              @db.JsonB
  variants     PrintAreaVariant[]
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("print_areas")
}

model PrintAreaVariant {
  printAreaId Int
  variantId   Int

  printArea PrintArea @relation(fields: [printAreaId], references: [id], onDelete: Cascade)
  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([printAreaId, variantId])
  @@map("print_area_variants")
}

/// ---------- Views ----------
model View {
  id         Int        @id @default(autoincrement()) 
  productId  String
  externalId Int
  label      String
  position   Position?
  files      ViewFile[]
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, externalId])                   // de-dupe per product
  @@map("views")
}

model ViewFile {
  id     BigInt  @id @default(autoincrement()) @db.BigInt
  viewId Int
  url    String
  role   String? @db.VarChar(64)
  data   Json?   @db.JsonB
  view   View    @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@index([viewId])
  @@map("view_files")
}

enum Role {
  DESIGNER
  ADMIN
}

/// Admin-curated product available to designers in the "Create Product" flow.
/// blueprintId/printProviderId/variant ids come from Printify's own catalog —
/// picked once by an admin rather than hand-typed guesses.
model CatalogTemplate {
  id              String   @id @default(cuid())
  name            String
  blueprintId     Int
  printProviderId Int
  mockupUrl       String
  overlayUrl      String?
  blendMode       String   @default("multiply")
  canvasW         Int
  canvasH         Int
  /// PrintZone[] — [{ id, label, x, y, w, h }]
  zones           Json
  defaultVariants Int[]
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
  @@map("catalog_templates")
}

/// Product created by designer and sent to Printify
/// ---------- Enums ----------
enum Position {
  front
  back
}

enum OptionType {
  size
  color
  custom
}
